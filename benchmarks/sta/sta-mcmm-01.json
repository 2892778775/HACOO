{
  "id": "sta-mcmm-01",
  "agent": "sta",
  "tool": "primetime",
  "description": "SO-1: 4 个 MCMM 场景创建后跨场景报告, 断言 per-scenario WNS 与全局最差值解析",
  "setup": {
    "mock_tool_state": {"mode": "mock"}
  },
  "script": [
    {"call": "api_load_design", "args": {"path": "chip.v", "top": "chip"}},
    {"call": "api_read_liberty", "args": {"path": "ss_0v99_125c.db"}},
    {"call": "api_mcmm_create_scenario", "args": {"name": "func.ss_0v99_125c",
        "mode": "func", "corner": "ss_0v99_125c",
        "lib_paths": ["ss_0v99_125c.db"], "sdc": "func.sdc"}},
    {"call": "api_mcmm_create_scenario", "args": {"name": "func.ff_1v10_m40c",
        "mode": "func", "corner": "ff_1v10_m40c",
        "lib_paths": ["ff_1v10_m40c.db"], "sdc": "func.sdc"}},
    {"call": "api_mcmm_create_scenario", "args": {"name": "test.ss_0v99_125c",
        "mode": "test", "corner": "ss_0v99_125c",
        "lib_paths": ["ss_0v99_125c.db"], "sdc": "test.sdc"}},
    {"call": "api_mcmm_create_scenario", "args": {"name": "test.ff_1v10_m40c",
        "mode": "test", "corner": "ff_1v10_m40c",
        "lib_paths": ["ff_1v10_m40c.db"], "sdc": "test.sdc"}},
    {"call": "api_mcmm_report_all", "args": {"max_paths": 5}},
    {"call": "api_decision_record", "args": {"stage": "sta_mcmm", "action": "mcmm_signoff",
                                             "rationale": "SO-1 MCMM 跨场景签核 (4 场景最差值判读)"}}
  ],
  "assertions": [
    {"type": "call_ok", "all": true},
    {"type": "output_contains", "step": 6, "text": "worst_scenario"},
    {"type": "output_contains", "step": 6, "text": "test.ss_0v99_125c"},
    {"type": "output_contains", "step": 6, "text": "global_wns"},
    {"type": "decision_recorded"}
  ],
  "tags": ["sta", "mcmm", "so-1", "golden"]
}
