{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "vllm-kimi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "KIMI 2.6 (vLLM)",
      "options": {
        "baseURL": "{env:VLLM_BASE_URL}",
        "apiKey": "{env:VLLM_API_KEY}"
      },
      "models": {
        "kimi2.6": {
          "name": "KIMI 2.6 (公司 vLLM)",
          "options": {}
        },
        "kimi-k2.6": {
          "name": "Kimi K2.6 (Moonshot API)",
          "options": {}
        }
      }
    }
  },
  "model": "vllm-kimi/kimi-k2.6",
  "mcp": {
    "hacoo": {
      "type": "local",
      "command": ["python", "-m", "hacoo.access.mcp_server"],
      "environment": {
        "HACOO_SERVER": "{env:HACOO_SERVER}",
        "HACOO_TOKEN": "{env:HACOO_TOKEN}",
        "PYTHONPATH": "."
      },
      "enabled": true
    }
  },
  "permission": {
    "hacoo*": "allow"
  }
}
